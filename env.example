import pytest

from bot.answer_check import is_answer_correct, split_translations


@pytest.mark.parametrize("answer", ["яблоко", "Яблоко", "  яблоко!  "])
def test_exact_match_ignores_case_and_punctuation(answer):
    assert is_answer_correct(answer, "яблоко")


def test_multiple_translations_and_synonyms_accepted():
    ru = "кот; кошка; котик"
    assert is_answer_correct("кошка", ru)
    assert is_answer_correct("котик", ru)


def test_parenthesized_notes_are_optional():
    assert is_answer_correct("здание", "дом (здание)")
    assert is_answer_correct("дом", "дом (здание)")


def test_yo_letter_normalized():
    assert is_answer_correct("ёлка", "елка")


def test_wrong_answer_rejected():
    assert not is_answer_correct("собака", "яблоко")


def test_empty_answer_rejected():
    assert not is_answer_correct("   ", "яблоко")


def test_small_typo_accepted_but_not_different_word():
    assert is_answer_correct("яблокк", "яблоко")
    assert not is_answer_correct("яма", "яблоко")


def test_split_translations():
    assert split_translations("кот, кошка / котик | кисочка") == ["кот", "кошка", "котик", "кисочка"]
